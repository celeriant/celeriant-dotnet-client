<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <RootNamespace>Celeriant.Transport</RootNamespace>
    <AssemblyName>Celeriant.Transport</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Celeriant.Transport</PackageId>
    <Version>0.1.0</Version>
    <Authors>Celeriant</Authors>
    <Description>Shared transport layer for Celeriant .NET clients: wire framing, zstd-dictionary compression, the Identify handshake, and the pooled TCP/TLS connection. Consumed by Celeriant.Client and Celeriant.Queue.Client; the body codec and message-type ids are injected per product.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://celeriant.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/celeriant/celeriant-db</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>celeriant;distributed-systems;wire-protocol;transport</PackageTags>
    <Copyright>Copyright (c) Celeriant contributors</Copyright>
  </PropertyGroup>

  <!-- SourceLink for debugger source stepping -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.4" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
